# Salin ke .env.local (tidak ikut git) lalu isi. Variabel VITE_* ditanam ke JavaScript klien,
# jadi HANYA isi dengan nilai yang memang publik.

# Dashboard Supabase > Connect (atau Project Settings > API): alamat proyek.
VITE_SUPABASE_URL=https://GANTI-DENGAN-PROJECT-REF.supabase.co

# Dashboard Supabase > Project Settings > API Keys: kunci "publishable" (sb_publishable_...) atau kunci "anon".
# JANGAN pakai kunci "secret" atau "service_role". Build akan gagal bila kunci rahasia terdeteksi.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase lokal (`supabase start`): URL http://127.0.0.1:54321, kunci dari `supabase status`.
# Mode contoh tanpa backend: `pnpm dev:fixture` (tidak butuh variabel di atas).
